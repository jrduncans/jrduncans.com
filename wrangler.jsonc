{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jrduncans-com",
	"compatibility_date": "2026-10-23",

	// Static assets only: no Worker script runs, so requests are free and
	// unmetered. Unknown paths get Cloudflare's plain 404.
	"assets": {
		"directory": "./public"
	},

	// Phase 1: serve only on workers.dev so the page can be checked before
	// cutover. Phase 2 (see README) replaces this with the custom domain:
	//   "workers_dev": false,
	//   "routes": [{ "pattern": "jrduncans.com", "custom_domain": true }]
	"workers_dev": true,
	"preview_urls": false
}
