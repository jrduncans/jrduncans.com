{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jrduncans-com",
	"compatibility_date": "2026-10-23",

	// Static assets only: no Worker script runs, so requests are free and
	// unmetered. Unknown paths get Cloudflare's plain 404.
	"assets": {
		"directory": "./public"
	},

	// Serve only on the canonical domain. Deploying creates its DNS record and
	// certificate. www.jrduncans.com redirects here via a zone Redirect Rule.
	"routes": [{ "pattern": "jrduncans.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
